{
  "name": "glider-cae",
  "productName": "Glider Flight Lab",
  "description": "Glider CAE and flight-physics suite: load a 3D glider model, estimate its aerodynamics and fly it.",
  "author": "Glider Flight Lab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/fetch-pyodide.mjs && vite",
    "build": "node scripts/fetch-pyodide.mjs && vite build",
    "preview": "vite preview",
    "test:py": "python -m pytest",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs",
    "electron:dev": "node scripts/fetch-pyodide.mjs && concurrently -k -n web,app \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "electron:start": "npm run fetch:pyodide && vite build && electron .",
    "dist:win": "npm run fetch:pyodide && vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run fetch:pyodide && vite build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@react-three/fiber": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "io.github.gliderflightlab",
    "productName": "Glider Flight Lab",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "package.json"],
    "afterPack": "scripts/adhoc-sign.cjs",
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GliderFlightLab-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "GliderFlightLab-Portable-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "GliderFlightLab-${version}-mac-${arch}.${ext}"
    }
  }
}
